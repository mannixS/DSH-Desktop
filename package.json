{
  "name": "dsh-desktop-client",
  "version": "1.0.0",
  "description": "DeepSeek Harness (dsh) 跨平台桌面客户端 —— 支持内核版本管理与自动/手动更新",
  "main": "src/main/main.js",
  "author": "DeepSeek Harness Client Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check-env.js",
    "build": "node scripts/build.js",
    "fetch-kernel": "node scripts/fetch-kernel.js",
    "pack:win": "npm run fetch-kernel && electron-builder --win",
    "pack:mac": "npm run fetch-kernel && electron-builder --mac",
    "pack": "npm run fetch-kernel && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {},
  "build": {
    "appId": "com.deepseek.dshdesktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
